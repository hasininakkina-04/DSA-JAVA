class Solution {
    public int dominantIndex(int[] nums) {
        int max=nums[0];
        int k =0;
        for(int i=1;i<nums.length;i++){
           if(max<nums[i]){
            max=nums[i];
            k=i;
           }   
        }
        int num=k;
        for(int j=0;j<nums.length;j++){
            if(nums[j]*2>max && j!=k){
                num=-1;
            }
        }
        return num;
    }
}

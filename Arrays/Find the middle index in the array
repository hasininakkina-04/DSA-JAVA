class Solution {
    public int findMiddleIndex(int[] nums) {
       int ts=0;
       int left=0;
       for(int num:nums){
         ts+=num;
       }
       for(int i=0;i<nums.length;i++){
         int right=ts-left-nums[i];
         if(right==left){
            return i;
         }
         left+=nums[i];
       } 
       return -1;
    }
}

class Solution {
    public int maxArea(int[] height) {
        int left=0;
        int p=0;
        int w=0;
        int right=height.length-1;
        while(left<right){
            if(height[left]<=height[right]){
                w =(right-left)*height[left];
                if(p<w){
                    p=w;
                }
                left++;
            }else if(height[left]>height[right]){
                w=(right-left)*height[right];
                if(p<w){
                    p=w;
                }
                right--;
            }    
        }
        return p;
    }
}
